<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <include
            android:id="@+id/toolbar_menu"
            layout="@layout/toolbar" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_texto_a_traducir"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbar_menu"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:hint="@string/presiona_boton"
            app:boxBackgroundColor="@color/color_surface"
            app:boxStrokeColor="@color/color_primary"
            app:hintTextColor="@color/color_on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_texto_a_traducir"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:textColor="@color/color_on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_texto_traducido"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/til_texto_a_traducir"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:hint="@string/traduccion"
            app:boxBackgroundColor="@color/color_surface"
            app:boxStrokeColor="@color/color_primary"
            app:hintTextColor="@color/color_on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_texto_traducido"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:textColor="@color/color_on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <TableLayout
            android:id="@+id/ll1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/til_texto_traducido"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_idioma_origen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/idioma_origen"
                android:textColor="@color/color_on_surface_variant"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_idioma_origen"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@color/color_surface"
                android:backgroundTint="@color/color_primary"
                android:popupBackground="@color/color_surface" />

            <TextView
                android:id="@+id/tv_idioma_a_traducir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="4dp"
                android:text="@string/idioma_a_traducir"
                android:textColor="@color/color_on_surface_variant"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_idioma_traduccion"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="@color/color_surface"
                android:backgroundTint="@color/color_primary"
                android:popupBackground="@color/color_surface" />
        </TableLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_traducir"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/ll1"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="@color/color_primary"
            android:text="@string/traducir"
            android:textColor="@color/color_on_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/translate_icon_white"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_reproducir"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/boton_traducir"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="@color/color_primary_dark"
            android:text="@string/reproducir"
            android:textColor="@color/color_on_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/play_arrow_icon_white"
            app:iconGravity="textStart" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_detectar_idioma_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/boton_reproducir"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:minHeight="48dp"
            android:text="@string/detectar_idioma_automaticamente"
            android:textColor="@color/color_on_surface"
            app:thumbTint="@color/color_secondary"
            app:trackTint="@color/color_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_capturar_voz"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/switch_detectar_idioma_auto"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/color_secondary"
            android:contentDescription="@string/captar_voz"
            android:text="@string/captar_voz"
            android:textColor="@color/color_on_secondary"
            app:cornerRadius="16dp"
            app:icon="@drawable/mic_icon_white"
            app:iconGravity="textStart" />

    </RelativeLayout>

</ScrollView>
